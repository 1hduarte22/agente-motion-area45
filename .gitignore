node_modules/
projetos/*/out/
projetos/*/assets/
# documentários: mídia pesada e renders ficam fora do git (só textos e roteiros são versionados)
projetos/**/final/*
!projetos/**/final/.gitkeep
projetos/**/pre-producao/*/*
!projetos/**/pre-producao/*/.gitkeep
templates/**/final/*
!templates/**/final/.gitkeep
templates/**/pre-producao/*/*
!templates/**/pre-producao/*/.gitkeep
